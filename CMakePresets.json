{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "CHROME 2000 - Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CHROME2000_BUILD_STANDALONE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2022-x64", "configuration": "Release", "jobs": 4 },
    { "name": "debug", "configurePreset": "vs2022-x64", "configuration": "Debug", "jobs": 4 }
  ]
}
